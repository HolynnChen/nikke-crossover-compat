+
+/***********************************************************************
+ *           ACE extended kernel exports
+ *
+ * Additional ntoskrnl.exe interfaces imported by ACE (Anti-Cheat Expert)
+ * that Wine leaves as stubs.  Discovered by parsing the PE import table of
+ * ACE-BASE.sys / ACE-CORE.sys / ACE-CORE.sys2 and diffing it against the
+ * exported symbols of the built ntoskrnl.exe: all 286 kernel imports were
+ * present, but 38 of them were unimplemented stubs.
+ *
+ * This group covers the ones backed by data Wine already maintains.
+ */
+
+/***********************************************************************
+ *           KeNumberProcessors   (NTOSKRNL.EXE.@)
+ */
+ULONG KeNumberProcessors;
+
+/***********************************************************************
+ *           MmUserProbeAddress   (NTOSKRNL.EXE.@)
+ */
+ULONG_PTR MmUserProbeAddress = 0x7fffffff;
+
+/***********************************************************************
+ *           SeExports   (NTOSKRNL.EXE.@)
+ */
+PVOID SeExports;
+
+/***********************************************************************
+ *           HalDispatchTable   (NTOSKRNL.EXE.@)
+ */
+PVOID HalDispatchTable;
+
+/***********************************************************************
+ *           PsJobType   (NTOSKRNL.EXE.@)
+ */
+POBJECT_TYPE PsJobType;
+
+/***********************************************************************
+ *           PsGetProcessPeb   (NTOSKRNL.EXE.@)
+ */
+PPEB WINAPI PsGetProcessPeb( PEPROCESS process )
+{
+    PPEB peb = NULL;
+
+    if (!process) return NULL;
+
+    if (process == PsInitialSystemProcess) return NULL; /* kernel process has no PEB */
+
+    if (NtQueryInformationProcess( (HANDLE)(ULONG_PTR)process->info.UniqueProcessId,
+                                   ProcessBasicInformation, &process->info,
+                                   sizeof(process->info), NULL ))
+        return NULL;
+
+    peb = process->info.PebBaseAddress;
+    TRACE( "process %p -> %p\n", process, peb );
+    return peb;
+}
+
+/***********************************************************************
+ *           PsGetProcessSessionId   (NTOSKRNL.EXE.@)
+ */
+ULONG WINAPI PsGetProcessSessionId( PEPROCESS process )
+{
+    PPEB peb;
+
+    if (!process) return 0;
+    if ((peb = PsGetProcessPeb( process ))) return peb->SessionId;
+    return 0;
+}
+
+/***********************************************************************
+ *           PsGetProcessCreateTimeQuadPart   (NTOSKRNL.EXE.@)
+ */
+LONGLONG WINAPI PsGetProcessCreateTimeQuadPart( PEPROCESS process )
+{
+    KERNEL_USER_TIMES times;
+
+    if (!process) return 0;
+
+    if (NtQueryInformationProcess( (HANDLE)(ULONG_PTR)process->info.UniqueProcessId,
+                                   ProcessTimes, &times, sizeof(times), NULL ))
+        return 0;
+
+    /* Windows reports creation time as a FILETIME quad. */
+    return times.CreateTime.QuadPart;
+}
+
+/***********************************************************************
+ *           PsGetCurrentThreadStackBase   (NTOSKRNL.EXE.@)
+ */
+PVOID WINAPI PsGetCurrentThreadStackBase(void)
+{
+    return NtCurrentTeb()->Tib.StackBase;
+}
+
+/***********************************************************************
+ *           PsGetCurrentThreadStackLimit   (NTOSKRNL.EXE.@)
+ */
+PVOID WINAPI PsGetCurrentThreadStackLimit(void)
+{
+    return NtCurrentTeb()->Tib.StackLimit;
+}
+
+/***********************************************************************
+ *           IoGetInitialStack   (NTOSKRNL.EXE.@)
+ */
+PVOID WINAPI IoGetInitialStack(void)
+{
+    return PsGetCurrentThreadStackBase();
+}
+
+/***********************************************************************
+ *           PsGetThreadWin32Thread   (NTOSKRNL.EXE.@)
+ *
+ * Windows stores a per-thread Win32 client pointer here.  Wine keeps its
+ * own TEB instead, so report the TEB as the Win32 thread block: callers
+ * only ever round-trip this value.
+ */
+PVOID WINAPI PsGetThreadWin32Thread( PETHREAD thread )
+{
+    if (!thread) return NULL;
+    if ((PETHREAD)thread == (PETHREAD)KeGetCurrentThread()) return NtCurrentTeb();
+
+    /* Another thread's TEB is not reachable from here without opening it. */
+    return NULL;
+}

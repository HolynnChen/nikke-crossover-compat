+NTSTATUS WINAPI PsGetProcessExitStatus( PEPROCESS process )
+{
+    PROCESS_BASIC_INFORMATION info;
+    HANDLE handle;
+    NTSTATUS status;
+
+    status = ObOpenObjectByPointer( process, OBJ_KERNEL_HANDLE, NULL,
+                                   PROCESS_QUERY_LIMITED_INFORMATION, PsProcessType, KernelMode, &handle );
+    if (status) return status;
+    status = NtQueryInformationProcess( handle, ProcessBasicInformation, &info, sizeof(info), NULL );
+    NtClose( handle );
+    TRACE( "%p status %#lx exit %#lx\n", process, status, status ? status : info.ExitStatus );
+    return status ? status : info.ExitStatus;
+}

Subject: [PATCH] ntoskrnl: skip the register form of the multi-byte NOP

Wine's kernel vectored handler emulates privileged instructions for
drivers but does not handle EXCEPTION_ILLEGAL_INSTRUCTION at all.

Rosetta 2 cannot translate the register form of the multi-byte NOP
(0F 1F /0 with ModRM.mod == 3) and raises an invalid-opcode exception
instead.  The encoding is valid x86 that real CPUs treat as a no-op, and
the memory forms of the same instruction translate fine, so only the CPU
emulator is at fault.

ACE's anti-cheat driver uses this encoding, so DriverEntry died on it and
the service failed with ERROR_GEN_FAILURE.  Decode the instruction and
skip it.

---

--- a/dlls/ntoskrnl.exe/instr.c
+++ b/dlls/ntoskrnl.exe/instr.c
@@ -917,7 +917,65 @@
  *
  * Vectored exception handler used to emulate protected instructions
  * from 64-bit code.
+ */
+
+/***********************************************************************
+ *           rosetta_nop_length
+ *
+ * Rosetta 2 cannot translate the register form of the multi-byte NOP
+ * (0F 1F /0 with ModRM.mod == 3): it raises SIGILL, which arrives here as
+ * EXCEPTION_ILLEGAL_INSTRUCTION.  The memory forms translate fine, so the
+ * encoding is legal x86 and only the CPU emulator is at fault.
+ *
+ * ACE's anti-cheat driver uses this exact encoding, so the driver died
+ * during DriverEntry and its service failed with ERROR_GEN_FAILURE, which
+ * made ACE refuse to start the game.
+ *
+ * A NOP only advances the instruction pointer, so decode its length and
+ * skip it.  Returns the length in bytes, or 0 if this is not such a NOP.
  */
+static int rosetta_nop_length( CONTEXT *context )
+{
+    BYTE *p = (BYTE *)context->Rip;
+    int i = 0, mod, rm;
+
+    if (!p) return 0;
+
+    /* legacy prefixes */
+    for (;;)
+    {
+        switch (p[i])
+        {
+        case 0x66: case 0x67: case 0xf2: case 0xf3:
+        case 0x2e: case 0x36: case 0x3e: case 0x26: case 0x64: case 0x65:
+            i++;
+            continue;
+        default:
+            break;
+        }
+        break;
+    }
+
+    /* REX prefix */
+    if (p[i] >= 0x40 && p[i] <= 0x4f) i++;
+
+    if (p[i] != 0x0f || p[i + 1] != 0x1f) return 0;
+
+    i += 2;
+    mod = (p[i] >> 6) & 3;
+    rm  = p[i] & 7;
+    i++;                                    /* ModRM */
+
+    if (mod == 3) return i;                 /* register form: what Rosetta rejects */
+
+    if (rm == 4) i++;                       /* SIB */
+    if (mod == 0 && rm == 5) i += 4;
+    else if (mod == 1) i += 1;
+    else if (mod == 2) i += 4;
+
+    return i;
+}
+
 LONG CALLBACK vectored_handler( EXCEPTION_POINTERS *ptrs )
 {
     EXCEPTION_RECORD *record = ptrs->ExceptionRecord;
@@ -932,7 +990,29 @@
         return EXCEPTION_CONTINUE_EXECUTION;
     }
 
+    if (record->ExceptionCode == EXCEPTION_ILLEGAL_INSTRUCTION)
+    {
+        int nop_len = rosetta_nop_length( context );
+        if (nop_len)
+        {
+            WARN( "emulating multi-byte NOP at %p (len %d); this CPU emulator cannot run it\n",
+                  (void *)context->Rip, nop_len );
+            context->Rip += nop_len;
+            return EXCEPTION_CONTINUE_EXECUTION;
+        }
+        /* Not something we know how to skip: log what stopped us, so an
+         * instruction the CPU emulator cannot run can be identified from a
+         * log instead of only from a crash. */
+        {
+            BYTE *b = (BYTE *)context->Rip;
+            ERR( "illegal instruction at %p:"
+                 " %02x %02x %02x %02x %02x %02x %02x %02x\n",
+                 b, b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7] );
+        }
+    }
+
     if (record->ExceptionCode == EXCEPTION_PRIV_INSTRUCTION ||
+        record->ExceptionCode == EXCEPTION_ILLEGAL_INSTRUCTION ||
         (record->ExceptionCode == EXCEPTION_ACCESS_VIOLATION &&
          record->ExceptionInformation[0] == EXCEPTION_READ_FAULT))
     {

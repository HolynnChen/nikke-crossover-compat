+/***********************************************************************
+ *           KeSetSystemGroupAffinityThread   (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI KeSetSystemGroupAffinityThread(GROUP_AFFINITY *affinity, GROUP_AFFINITY *previous)
+{
+    KAFFINITY old;
+
+    TRACE("affinity %p previous %p.\n", affinity, previous);
+
+    if (!affinity) return STATUS_INVALID_PARAMETER;
+
+    old = KeSetSystemAffinityThreadEx(affinity->Mask);
+
+    if (previous)
+    {
+        memset(previous, 0, sizeof(*previous));
+        previous->Mask = old;
+    }
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           KeRevertToUserGroupAffinityThread   (NTOSKRNL.EXE.@)
+ */
+void WINAPI KeRevertToUserGroupAffinityThread(GROUP_AFFINITY *previous)
+{
+    TRACE("previous %p.\n", previous);
+
+    if (previous && previous->Mask) KeSetSystemAffinityThreadEx(previous->Mask);
+    else KeRevertToUserAffinityThread();
+}
+
+/***********************************************************************
+ *           KeGetProcessorNumberFromIndex   (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI KeGetProcessorNumberFromIndex(ULONG index, PROCESSOR_NUMBER *number)
+{
+    TRACE("index %lu number %p.\n", index, number);
+
+    if (!number) return STATUS_INVALID_PARAMETER;
+
+    memset(number, 0, sizeof(*number));
+    number->Group = 0;
+    number->Number = index;
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           PsGetCurrentThreadTeb   (NTOSKRNL.EXE.@)
+ */
+void *WINAPI PsGetCurrentThreadTeb(void)
+{
+    return NtCurrentTeb();
+}
+
+/***********************************************************************
+ *           ObDereferenceObjectDeferDelete   (NTOSKRNL.EXE.@)
+ */
+void WINAPI ObDereferenceObjectDeferDelete(void *object)
+{
+    TRACE("object %p.\n", object);
+    ObfDereferenceObject(object);
+}

+/***********************************************************************
+ *           KeTryToAcquireGuardedMutex   (NTOSKRNL.EXE.@)
+ *
+ * Non-blocking variant: uses the underlying fast mutex counter. Count == 1
+ * means free, 0 means held (see ExAcquireFastMutexUnsafe).
+ */
+BOOLEAN WINAPI KeTryToAcquireGuardedMutex(PKGUARDED_MUTEX mutex)
+{
+    PFAST_MUTEX fast = (PFAST_MUTEX)mutex;
+    LONG count;
+
+    TRACE("mutex %p.\n", mutex);
+
+    count = InterlockedDecrement(&fast->Count);
+    if (count < 0)
+    {
+        InterlockedIncrement(&fast->Count);
+        return FALSE;
+    }
+    return TRUE;
 }
+
+/***********************************************************************
+ *           KeIpiGenericCall   (NTOSKRNL.EXE.@)
+ *
+ * Wine has no inter-processor interrupt support. The broadcast worker is run
+ * once on the current processor, which is the whole job on a single "CPU".
+ */
+ULONG_PTR WINAPI KeIpiGenericCall(ULONG_PTR (*callback)(ULONG_PTR), ULONG_PTR context)
+{
+    if (!callback) return 0;
+
+    FIXME("callback %p context %#Ix: running on the current processor only\n", callback, context);
+    return callback(context);
+}
